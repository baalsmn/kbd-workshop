# generated by tools/build.sh, tools/case.sh, tools/render.sh
build/
# keycaps/build holds the keycap scripts (tracked); their generated files go to keycaps/build/work
!keycaps/build/
keycaps/build/work/
# keycaps/results: the print 3MFs and profiles are tracked, the Fusion designs kept locally (user 2026-11-09)
keycaps/results/*.f3d
out/
# installed on first use by tools/case.sh
tools/jscad/node_modules/
tools/jscad/package-lock.json
# KiCad local state
*.kicad_prl
*-backups/
fp-info-cache
__pycache__/
# editor settings Fusion creates next to scripts
.vscode/
# KiCad lock and autosave files
*.lck
_autosave-*
# KiCad local history
.history/
# trademarked logo artwork: kept locally, not in the repo
ergogen/footprints/local/
drafts/claude*
kicad-libraries/Footprints/Keyboard.pretty/Logo.kicad_mod
kicad-libraries/Footprints/Keyboard.pretty/Claude_Logo_8mm.kicad_mod
# vendor 3D models and footprints (not redistributable / unknown licence): kept
# locally for reference; the repo uses the recreated models (tools/lib/make_models.py)
vendor/
# vendor models are committed once, in kicad-libraries/3dmodels/; the project copies
# (<keyboard>/kicad/libraries/3dmodels/vendor_*) are made locally (see CLAUDE.md)
*/kicad/libraries/3dmodels/vendor_*

# Fabrication Toolkit output (regenerated in KiCad)
**/kicad/production/
